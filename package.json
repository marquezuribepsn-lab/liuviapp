  "description": "Sistema de ventas para local de ropa: stock, artículos, caja, estadísticas y lector de código de barras",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "restore": "node --disable-warning=ExperimentalWarning scripts/restore.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  }
}
